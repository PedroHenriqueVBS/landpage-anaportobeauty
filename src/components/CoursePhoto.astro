---
interface Props {
  variant?: "braid" | "half" | "pony";
  eager?: boolean;
}
const { variant = "braid", eager = false } = Astro.props;
const widths = { braid: [195, 390], half: [111, 222], pony: [114, 228] };
const [small, large] = widths[variant];
const height = variant === "braid" ? 435 : 184;
const descriptions = {
  braid:
    "Detalhe de uma trança em cabeça de treino, do material oficial do curso",
  half: "Semipreso com trança e cabelos soltos, do material oficial do curso",
  pony: "Rabo de cavalo com trança, do material oficial do curso",
};
---

<div class:list={["course-photo", `course-photo--${variant}`]}>
  <img
    src={`/images/curso-${variant}-${large}.webp`}
    srcset={`/images/curso-${variant}-${small}.webp ${small}w, /images/curso-${variant}-${large}.webp ${large}w`}
    sizes={eager
      ? "(min-width: 1100px) 490px, (min-width: 701px) 43vw, calc(100vw - 40px)"
      : "(min-width: 1100px) 375px, (min-width: 701px) 30vw, calc(100vw - 40px)"}
    width={large}
    height={height}
    alt={descriptions[variant]}
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
  />
</div>
