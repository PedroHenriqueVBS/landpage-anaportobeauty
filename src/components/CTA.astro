---
import { onlineCourse } from "../data/site";
import Icon from "./Icon.astro";
interface Props {
  label?: string;
  variant?: "light" | "dark";
  class?: string;
}
const {
  label = "Quero aprender penteados",
  variant = "dark",
  class: className = "",
} = Astro.props;
---

<a
  href={onlineCourse.checkoutUrl}
  class:list={["cta", `cta--${variant}`, className]}
  >{label}<Icon name="arrow" /></a
>
