---
import PageHead from "../components/PageHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ContactCTA from "../components/ContactCTA.astro";
import PartnersSection from "../components/PartnersSection.astro";
import Icon from "../components/Icon.astro";
import { contact, whatsappLink } from "../data/site";
import {
  serviceGroups,
  bridalServices,
  serviceQuestions,
  formatPrice,
} from "../data/services";
import "../styles/global.css";
import "../styles/services.css";

const title = "Cabelo e maquiagem em domicílio em Campina Grande | Ana Porto";
const description =
  "Cabeleireira e maquiadora em domicílio em Campina Grande/PB. Cortes, escova, penteados e maquiagem para festas e noivas. Agende com Ana Lucia Porto.";
const area = {
  "@type": "City",
  name: "Campina Grande",
  containedInPlace: { "@type": "State", name: "Paraíba" },
};
const businessId = Astro.site
  ? new URL("/#ana-lucia-porto", Astro.site).href
  : undefined;
const provider = {
  "@type": "Organization",
  "@id": businessId,
  name: contact.name,
  url: Astro.site?.href,
  telephone: contact.telephone,
  areaServed: area,
  sameAs: [contact.instagram, contact.tiktok],
};
const catalogServices = [
  ...serviceGroups.flatMap((group) => group.services),
  ...bridalServices,
];
// O catálogo descreve serviços em domicílio, sem inventar endereço de salão.
const schema = {
  "@context": "https://schema.org",
  ...provider,
  description,
  image: Astro.site
    ? new URL("/images/ana-atendimento-832.webp", Astro.site).href
    : undefined,
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Cabelo e maquiagem em domicílio em Campina Grande",
    itemListElement: catalogServices.map((service) => ({
      "@type": "Offer",
      url: whatsappLink(
        `Olá, Ana! Gostaria de saber a disponibilidade para ${service.name.toLowerCase()} em domicílio.`,
      ),
      priceCurrency: "BRL",
      ...("startingAt" in service || "maxPrice" in service
        ? {
            priceSpecification: {
              "@type": "PriceSpecification",
              minPrice: service.price,
              ...("maxPrice" in service ? { maxPrice: service.maxPrice } : {}),
              priceCurrency: "BRL",
            },
          }
        : { price: service.price }),
      itemOffered: {
        "@type": "Service",
        name: service.name,
        areaServed: area,
        provider: businessId ? { "@id": businessId } : provider,
      },
    })),
  },
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <PageHead
      title={title}
      description={description}
      image="/images/ana-atendimento-832.webp"
      imageAlt="Ana Lucia Porto, cabeleireira e maquiadora em Campina Grande"
      schema={schema}
    />
  </head>
  <body class="services-page">
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <SiteHeader current="home" />
    <main id="conteudo">
      <section class="hero service-hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">CAMPINA GRANDE · PARAÍBA</p>
          <p class="course-name">Ana Lucia Porto · beleza em domicílio</p>
          <h1 id="hero-title">
            Cabelo e maquiagem<br /><em>em domicílio.</em>
          </h1>
          <p class="hero-description">
            Seu momento de beleza, no conforto da sua casa. Cabeleireira e
            maquiadora em Campina Grande para cuidar de você, do corte à
            produção para uma ocasião especial.
          </p>
          <ContactCTA class="hero-checkout" />
          <a class="text-link hero-services-link" href="#servicos">
            Conhecer serviços e valores <Icon name="arrow" />
          </a>
          <p class="hero-meta">
            Atendimento com hora marcada · consulte a disponibilidade
          </p>
        </div>
        <figure class="service-hero-art">
          <img
            src="/images/ana-atendimento-832.webp"
            srcset="/images/ana-atendimento-480.webp 480w, /images/ana-atendimento-832.webp 832w"
            sizes="(min-width: 1100px) 490px, (min-width: 701px) 43vw, calc(100vw - 40px)"
            width="832"
            height="1248"
            alt="Ana Lucia Porto com secador e materiais de maquiagem, pronta para o atendimento"
            loading="eager"
            fetchpriority="high"
          />
          <figcaption>
            <span>CABELO · MAQUIAGEM · PENTEADOS</span>
            <strong>O cuidado vai até você.</strong>
          </figcaption>
        </figure>
      </section>
      <div class="benefit-strip service-benefits">
        <div class="wrap">
          <span><Icon name="check" />Mais de 20 anos de experiência</span>
          <span><Icon name="home" />Atendimento em domicílio</span>
          <span><Icon name="sparkle" />Produção para cada ocasião</span>
        </div>
      </div>

      <section
        class="service-menu section"
        id="servicos"
        aria-labelledby="services-title"
      >
        <div class="wrap">
          <div class="section-heading">
            <div>
              <p class="eyebrow">ESCOLHA O SEU CUIDADO</p>
              <h2 id="services-title">
                Serviços de beleza.<br /><em>Sem sair de casa.</em>
              </h2>
            </div>
            <p>
              Maquiagem, penteados e cuidados com o cabelo. Encontre seu serviço
              e combine os detalhes com Ana.
            </p>
          </div>
          <div class="service-price-grid">
            {
              serviceGroups.map((group, index) => (
                <article class="service-price-card">
                  <p class="eyebrow">
                    0{index + 1} · ATENDIMENTO PERSONALIZADO
                  </p>
                  <h3>{group.title}</h3>
                  <p class="service-card-description">{group.subtitle}</p>
                  <ul class="service-price-list">
                    {group.services.map((service) => (
                      <li>
                        <a
                          href={whatsappLink(
                            `Olá, Ana! Tenho interesse em ${service.name.toLowerCase()} em domicílio em Campina Grande. Pode me informar a disponibilidade e os detalhes?`,
                          )}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-describedby="service-contact-help"
                        >
                          <span>{service.name}</span>
                          <strong>{formatPrice(service)}</strong>
                          <Icon name="arrow" />
                        </a>
                      </li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
          <div class="service-menu-note">
            <div>
              <p id="service-contact-help">
                Selecione um serviço para consultar pelo WhatsApp.
              </p>
              <p>
                Valores conforme os materiais de atendimento. Para serviços com
                preço “a partir de” e penteado infantil, confirme o valor da sua
                produção. Consulte deslocamento e disponibilidade antes de
                reservar.
              </p>
            </div>
            <ContactCTA label="Consultar minha data" />
          </div>
        </div>
      </section>

      <section
        class="bridal-section section"
        id="noivas"
        aria-labelledby="bridal-title"
      >
        <div class="wrap bridal-grid">
          <div class="bridal-copy">
            <p class="eyebrow">UM DIA PARA GUARDAR</p>
            <h2 id="bridal-title">
              Maquiagem e penteado<br /><em>para noivas.</em>
            </h2>
            <p>
              Uma produção pensada para o seu grande dia. Converse sobre o
              estilo que deseja e organize os testes e o atendimento com Ana.
            </p>
            <ul class="bridal-price-list">
              {
                bridalServices.map((service) => (
                  <li>
                    <>
                      <span>{service.name}</span>
                      <strong>{formatPrice(service)}</strong>
                    </>
                  </li>
                ))
              }
            </ul>
            <p class="bridal-note">
              Acompanhamento com reserva de 3 horas. Traslado cobrado à parte.
              Consulte os horários e as condições para o seu evento.
            </p>
            <ContactCTA
              variant="light"
              label="Conversar sobre o meu dia"
              message="Olá, Ana! Gostaria de conhecer o atendimento de maquiagem e penteado para noiva. Podemos conversar sobre a minha data, os testes e o deslocamento?"
            />
          </div>
          <figure class="bridal-image">
            <img
              src="/images/noiva-1080.webp"
              srcset="/images/noiva-540.webp 540w, /images/noiva-1080.webp 1080w"
              sizes="(min-width: 701px) 43vw, calc(100vw - 40px)"
              width="1080"
              height="1080"
              alt="Maquiagem e penteado de noiva apresentados no catálogo de Ana Lucia Porto"
              loading="lazy"
            />
            <figcaption>Beleza para viver seus momentos especiais.</figcaption>
          </figure>
        </div>
      </section>

      <section
        class="experience booking-section section wrap"
        id="como-agendar"
        aria-labelledby="booking-title"
      >
        <div>
          <p class="eyebrow">VAMOS COMBINAR?</p>
          <h2 id="booking-title">
            Beleza em Campina Grande.<br /><em>Agende em três passos.</em>
          </h2>
          <p>
            Cabelo e maquiagem em domicílio em Campina Grande, Paraíba. Envie
            seu bairro, endereço e horário para confirmar a disponibilidade.
            Para outras localidades, consulte antes de reservar.
          </p>
        </div>
        <ol class="feature-list">
          <li>
            <span aria-hidden="true">01</span><div>
              <h3>Conte o que você precisa</h3><p>
                Envie o serviço desejado, a data, seu bairro e o horário em que
                precisa estar pronta pelo WhatsApp.
              </p>
            </div>
          </li>
          <li>
            <span aria-hidden="true">02</span><div>
              <h3>Combine os detalhes com Ana</h3><p>
                Confirme disponibilidade, valor total e orientações para o
                atendimento. Para noivas, o traslado é cobrado à parte; nos
                demais serviços, combine as condições de deslocamento.
              </p>
            </div>
          </li>
          <li>
            <span aria-hidden="true">03</span><div>
              <h3>Reserve o seu horário</h3><p>
                Após combinar as condições e o sinal da reserva, prepare-se para
                receber seu atendimento em domicílio.
              </p>
            </div>
          </li>
        </ol>
      </section>

      <section class="about-services section" aria-labelledby="about-title">
        <div class="wrap about-services-grid">
          <figure class="about-service-photo">
            <img
              src="/images/maquiagem-domicilio-1000.webp"
              srcset="/images/maquiagem-domicilio-640.webp 640w, /images/maquiagem-domicilio-1000.webp 1000w"
              sizes="(min-width: 701px) 45vw, calc(100vw - 40px)"
              width="1000"
              height="668"
              alt="Aplicação de batom com pincel durante uma produção de maquiagem"
              loading="lazy"
            />
            <figcaption>
              Experiência, atenção e cuidado em cada detalhe.
            </figcaption>
          </figure>
          <div class="teacher-copy">
            <p class="eyebrow">CONHEÇA SUA PROFISSIONAL</p>
            <h2 id="about-title">
              Ana Lucia Porto.<br /><em>Beleza com experiência.</em>
            </h2>
            <p>
              Cabeleireira, maquiadora e penteadista com mais de 20 anos de
              experiência. Em Campina Grande, Ana leva o atendimento
              personalizado até você.
            </p>
            <p>
              Da rotina às celebrações, cada produção começa com uma conversa
              sobre o que você deseja. Conheça mais do trabalho nas redes
              sociais.
            </p>
            <div class="social-links">
              <a
                class="text-link"
                href={contact.instagram}
                target="_blank"
                rel="noopener noreferrer">Instagram <Icon name="arrow" /></a
              >
              <a
                class="text-link"
                href={contact.tiktok}
                target="_blank"
                rel="noopener noreferrer">TikTok <Icon name="arrow" /></a
              >
            </div>
          </div>
        </div>
      </section>

      <section class="faq service-faq section wrap" aria-labelledby="faq-title">
        <div>
          <p class="eyebrow">ANTES DE RESERVAR</p>
          <h2 id="faq-title">Dúvidas<br /><em>frequentes.</em></h2>
          <p>Sobre agendamento, valores e o atendimento na sua casa.</p>
        </div>
        <div class="faq-list">
          {
            serviceQuestions.map(({ question, answer }, index) => (
              <details class="faq-item" open={index === 0}>
                <summary>
                  {question}
                  <Icon name="plus" />
                </summary>
                <div class="faq-answer">
                  <p>{answer}</p>
                </div>
              </details>
            ))
          }
        </div>
      </section>

      <section
        class="course-invitation wrap"
        aria-labelledby="course-invitation-title"
      >
        <div>
          <p class="eyebrow">ALPORTO ACADEMY · FORMAÇÃO EM BELEZA</p>
          <h2 id="course-invitation-title">
            Também quer <em>aprender penteados?</em>
          </h2>
          <p>
            Conheça o Descomplica Penteado, o curso online de Ana para começar
            do zero, e as opções de cursos presenciais em turma ou VIP.
          </p>
        </div>
        <div class="course-invitation-links">
          <a class="text-link" href="/curso-de-penteados/"
            >Conhecer o curso online <Icon name="arrow" /></a
          >
          <a class="text-link" href="/cursos-presenciais/"
            >Conhecer os cursos presenciais <Icon name="arrow" /></a
          >
        </div>
      </section>

      <PartnersSection />

      <section
        class="final-cta contact-section"
        id="contato"
        aria-labelledby="contact-title"
      >
        <div class="wrap">
          <p class="eyebrow">CABELO E MAQUIAGEM EM CAMPINA GRANDE</p>
          <h2 id="contact-title">
            Seu próximo momento.<br /><em>Seu cuidado com Ana.</em>
          </h2>
          <p>
            Envie sua data e o serviço desejado. Vamos combinar seu atendimento
            em domicílio.
          </p>
          <ContactCTA label="Quero agendar meu atendimento" />
          <p class="final-note">
            WhatsApp {contact.phoneDisplay} · atendimento com hora marcada
          </p>
        </div>
      </section>
    </main>
    <SiteFooter />
    <aside
      class="mobile-cta service-mobile-cta"
      aria-label="Agendar atendimento em domicílio"
      hidden
    >
      <span>Ana Lucia Porto<strong>Beleza em domicílio</strong></span>
      <ContactCTA label="Agendar" />
    </aside>
    <script>
      // Mostra o atalho mobile após o hero, quando não há outro CTA visível.
      const bar = document.querySelector<HTMLElement>(".service-mobile-cta");
      const heroCTA = document.querySelector<HTMLElement>(".hero-checkout");
      const inlineCTAs = [
        ...document.querySelectorAll<HTMLElement>("main .cta"),
      ];
      if (bar && heroCTA && "IntersectionObserver" in window) {
        const mobile = window.matchMedia("(max-width: 700px)");
        const update = () => {
          const passedHero = heroCTA.getBoundingClientRect().bottom < 0;
          const visibleCTA = inlineCTAs.some((cta) => {
            const rect = cta.getBoundingClientRect();
            return rect.bottom > 0 && rect.top < window.innerHeight;
          });
          const hasFocus = bar.contains(document.activeElement);
          bar.hidden =
            !mobile.matches || (!hasFocus && (!passedHero || visibleCTA));
        };
        const observer = new IntersectionObserver(update, {
          threshold: [0, 1],
        });
        inlineCTAs.forEach((cta) => observer.observe(cta));
        mobile.addEventListener("change", update);
        window.addEventListener("resize", update, { passive: true });
        bar.addEventListener("focusout", () => requestAnimationFrame(update));
        update();
      }
    </script>
  </body>
</html>
